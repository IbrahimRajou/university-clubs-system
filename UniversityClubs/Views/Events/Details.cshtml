@model UniversityClubs.Models.Event

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Site.css" rel="stylesheet" />

<div class="event-details-page">
    <h2>@Model.Title</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="event-details-content">
        
        <div class="event-images">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="~/Images/@Model.ImagePath" alt="@Model.Title" class="main-event-image" />
            }
            else
            {
                <div class="image-placeholder">
                    <i class="fas fa-calendar-alt"></i>
                    <p>No image available</p>
                </div>
            }
        </div>

        <div class="event-info">
            <div class="info-section">
                <h3><i class="fas fa-info-circle"></i> Description</h3>
                <p>@Model.Description</p>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <h4><i class="fas fa-calendar"></i> Date</h4>
                    <p>@Model.Date</p>
                </div>
                <div class="info-item">
                    <h4><i class="fas fa-map-marker-alt"></i> Location</h4>
                    <p>@Model.Location</p>
                </div>
                <div class="info-item">
                    <h4><i class="fas fa-users"></i> Club</h4>
                    <p>@Model.Club.Name</p>

                    @*<p>@Model.Club?.Name</p>*@
                </div>
                <div class="info-item">
                    <h4><i class="fas fa-user-check"></i> Participation</h4>
                    <p>@Model.ParticipantsCount / @Model.Capacity participants</p>
                </div>
            </div>

            <div class="participation-section">
                @if (Model.ParticipantsCount < Model.Capacity)
                {
                    <a  class="btn btn-participate-large">
                        <i class="fas fa-user-plus"></i> Join This Event
                    </a>
                    <p class="spots-remaining">@(Model.Capacity - Model.ParticipantsCount) spots remaining</p>
                }
                else
                {
                    <button class="btn btn-full-large" disabled>
                        <i class="fas fa-ban"></i> Event Full
                    </button>
                    <p class="spots-remaining">No spots available</p>
                }

                <div class="action-buttons">
                    <a href="@Url.Action("Index")" class="btn btn-back">
                        <i class="fas fa-arrow-left"></i> Back to Events
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

