@model UniversityClubs.Models.Club

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit A Club</title>
    <link href="~/Content/CreateEdit.css" rel="stylesheet" />
</head>
<body>
    <h3>Edit A Club</h3>
    @using (Html.BeginForm("EditClub", "Club", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.Partial("_CreateEditClub")
        <div class="Last-Bottom">
            <div class="Club-btn">
                <p><input type="submit" value="Edit Club" /></p>
            </div>
        </div>
    }
</body>
</html>
