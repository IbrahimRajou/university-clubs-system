@model UniversityClubs.Models.Club

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create A Club</title>
    <link href="~/Content/CreateEdit.css" rel="stylesheet"/>
</head>
<body>
    @if (TempData["ClubHasBeenCreated"] == "true")
    {
        <script>
            alert("The club has been created!!");
        </script>
    }
    <h3>Create A Club</h3>
    @using (Html.BeginForm("CreateClub", "Club", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.Partial("_CreateEditClub")
        <div class="Last-Bottom">
            <div class="Club-btn">
                <p><input type="submit" value="Create Club" /></p>
            </div>
        </div>
    }
</body>
</html>
