<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - UniClubs</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="@Url.Content("~/Content/UniClubs.css")" rel="stylesheet" />
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>
    <div id="toast-container"></div>

    <nav class="navbar">
        <div class="nav-container">
            <div class="brand" onclick="window.scrollTo({top:0,behavior:'smooth'})">
                <div class="brand-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                <span>@Html.ActionLink("UniClubs", "Index", "Home")</span>
            </div>
            <div class="flex" style="gap:12px;">
                @Html.ActionLink("Home", "Index", "Home", null, new { @class = "btn btn-text" })
                @Html.ActionLink("Clubs", "Index", "Club", null, new { @class = "btn btn-text" })
                @Html.ActionLink("Events", "Index", "Events", null, new { @class = "btn btn-text" })
                <a href="~/Home/Index/#section-about" class="btn btn-text">About Us</a>
                <a href="~/Home/Index/#section-contact" class="btn btn-text">Contact</a>
                @{
                    var role = ViewBag.Role as string ?? (Session["Role"] as string);
                }

                @if (!string.IsNullOrEmpty(role) && role == "Admin")
                {
                    <p class="btn btn-text" style="background-color: black; color: white; border-radius: 10px;"><b>ADMIN</b></p>
                    @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "btn btn-text" })
                    @*@Html.ActionLink("Create Club", "CreateClub", "Club", null, new { @class = "btn btn-text" });*@

                }
                else if (!string.IsNullOrEmpty(role) && role == "Student")
                {
                    <p class="btn btn-text" style="background-color: black; color: white; border-radius: 10px;"><b>STUDENT</b></p>
                    @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "btn btn-text" })
                }
                else
                {
                    @Html.ActionLink("Login", "Index", "Account", null, new { @class = "btn btn-text" })
                }
            </div>
        </div>
    </nav>

    @RenderBody()

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>