@model UniversityClubs.Models.Club

<div class="main">
    <div class="Create-Box">
        <div class="Top-Note">
            <p style="margin: 10px;"><span>*</span> <b style=" opacity: 0.5;">indicates a required field</b></p>
            @Html.ValidationSummary()
        </div>
        <div class="Top" style="justify-content: space-between; margin-top: 0px;">
            <div class="Club-Name" style="padding-left: 0px; margin-left: 0px;">
                <p>Club Name:<span>*</span></p>
                <p>@Html.TextBoxFor(x => x.Name, new { style = "width: 250px; height: 30px; padding: 5px;", placeHolder = "Enter Club Name" })</p>
            </div>
            <div class="Club-Category" style="margin: 10px 50px;">
                <p>Club Category:<span>*</span></p>
                <p>@Html.DropDownListFor(x => x.Category, ViewBag.CategoriesList as SelectList, "Select One", new { style = "width: 120px; height: 30px;" })</p>
            </div>
            <div class="Club-LogoPath">
                <p>Club Logo:</p>
                <p><input type="file" name="file" style="width: 200px; " /></p>
            </div>
        </div>
        <div class="Middle">
            <div class="Club-Mission">
                <p>Club Mission:<span>*</span></p>
                <p>@Html.TextAreaFor(x => x.Mission, new { style = "width: 250px; height: 70px; padding: 5px; resize: none;", placeHolder = "Enter Club Mission" })</p>
            </div>
            <div class="Club-Vision" style="margin: 0px 30px;">
                <p>Club Vision:<span>*</span></p>
                <p>@Html.TextAreaFor(x => x.Vision, new { style = "width: 250px; height: 70px; padding: 5px; resize: none;", placeHolder = "Enter Club Vision" })</p>
            </div>
            <div class="Club-Goals">
                <p>Club Goals:<span>*</span></p>
                <p>@Html.TextAreaFor(x => x.Goals, new { style = "width: 250px; height: 70px; padding: 5px; resize: none;", placeHolder = "Enter Club Goals" })</p>
            </div>
        </div>
        <div class="Bottom-1">
            <div class="Club-Description">
                <p>Club Description:<span>*</span></p>
                <p>@Html.TextAreaFor(x => x.Description, new { style = "width: 600px; height: 80px; padding: 5px; resize: none;", placeHolder = "Enter Club Description" })</p>
            </div>
        </div>
        <div class="Bottom-2">
            <div class="Contact-info">
                <div class="Club-Brief">
                    <p>Club Brief Description:<span>*</span></p>
                    <p>@Html.TextAreaFor(x => x.briefDesc, new { style = "width: 250px; height: 70px; padding: 5px; resize: none;", placeHolder = "Enter Club Brief Description" })</p>
                </div>
                <div class="Club-Phone">
                    <p>Club Phone Number:<span>*</span></p>
                    <p>@Html.TextBoxFor(x => x.Phone, new { style = "width: 250px; height: 40px; padding: 5px;", placeHolder = "e.g. 0712345678" })</p>
                </div>
                <div class="Club-Room">
                    <p>Club Room:<span>*</span></p>
                    <p>@Html.TextBoxFor(x => x.Room, new { style = "width: 250px; height: 40px; padding: 5px;", placeHolder = "e.g. 101" })</p>
                </div>
            </div>
        </div>
    </div>
</div>