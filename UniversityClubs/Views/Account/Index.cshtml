@model UniversityClubs.Models.User

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>UniClubs | Login</title>
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI",Tahoma,sans-serif;
            background: #f5f6fa;
        }

        .navbar {
            background: #3f3d56;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-weight: bold;
            font-size: 20px;
            cursor: pointer;
        }

        .nav-items {
            display: flex;
            gap: 15px;
            align-items: center;
        }

            .nav-items a {
                color: #ddd;
                text-decoration: none;
                font-weight: 500;
                font-size: 14px;
            }

                .nav-items a:hover {
                    color: #fbc531;
                }

        .login-btn {
            background: #fbc531;
            padding: 8px 18px;
            border-radius: 20px;
            color: #000;
            font-weight: 600;
            text-decoration: none;
        }

        .container {
            min-height: calc(100vh-70px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding-top: 20px;
        }

        .login-card {
            background: #fff;
            width: 320px;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            text-align: center;
        }

        .icon {
            width: 60px;
            height: 60px;
            background: #eef0ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 28px;
        }

        h2 {
            margin: 10px 0 6px;
            font-size: 22px;
        }

        .subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .field-label {
            display: block;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            color: #555;
            margin-bottom: 6px;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: none;
            background: #5a54e8;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .error {
            color: red;
            margin-bottom: 10px;
            text-align: left;
        }

        .demo {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            color: #8a6a2a;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
            font-size: 14px;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="login-card">
            <div class="icon">🎓</div>
            <h2>Welcome Back</h2>
            <div class="subtitle">Please sign in to continue</div>

            @Html.ValidationSummary(true, "", new { @class = "error" })

            @using (Html.BeginForm("Index", "User", FormMethod.Post))
            {
                <label class="field-label">Email</label>
                @Html.TextBoxFor(m => m.Email, new { placeholder = "example@uni.edu" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "error" })

                <label class="field-label">PASSWORD</label>
                @Html.PasswordFor(m => m.Password, new { placeholder = "••••••" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "error" })


                <button type="submit">Sign In</button>
            }
        </div>
    </div>
</body>
</html>



